{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.local/schemas/fabric-app-v0.1.json",
  "title": "Fabric App Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fabric_app",
    "id",
    "name",
    "entrypoint",
    "pages"
  ],
  "properties": {
    "fabric_app": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.fabric$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      }
    }
  }
}
